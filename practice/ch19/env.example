# CI 用環境變數範本：只放變數名與假值，真值放 CI Secret / Secret Manager
# 使用時複製成 .env 後填入（.env 已列入 .gitignore，不可 commit）
# 註：本應命名為 .env.example，但本機權限設定禁止寫入 .env* 檔，故改名 env.example

# Console 工作區發的 API Key（請勿使用個人 Pro/Max 憑證）
ANTHROPIC_API_KEY=<填入-CI-工作區金鑰>

# 金鑰所屬工作區與名稱，方便輪替時追蹤（不是機密）
ANTHROPIC_WORKSPACE=ci-review
ANTHROPIC_KEY_NAME=ci-review-YYYY-MM

# 若有資料駐留需求，改走雲端供應商（二擇一，帳號需另外申請）
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=<填入區域>
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=<填入區域>
# ANTHROPIC_VERTEX_PROJECT_ID=<填入專案ID>
