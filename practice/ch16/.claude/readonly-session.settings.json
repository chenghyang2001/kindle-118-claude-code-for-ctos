{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(npm test:*)"
    ],
    "deny": [
      "Write",
      "Edit",
      "NotebookEdit",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git merge:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(npm install:*)"
    ]
  }
}
