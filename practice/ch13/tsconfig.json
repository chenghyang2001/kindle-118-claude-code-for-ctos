{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/api/orders/**/*.js",
    "src/db/ordersRepo.js",
    "src/api/users/**/*.js",
    "src/db/usersRepo.js"
  ]
}
