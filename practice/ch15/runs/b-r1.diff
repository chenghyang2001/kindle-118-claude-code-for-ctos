+
+test('order model：priority 預設 normal、非法值報錯', () => {
+  assert.equal(buildOrder('order-x', VALID).priority, 'normal');
+  assert.equal(buildOrder('order-x', { ...VALID, priority: 'high' }).priority, 'high');
+  for (const priority of ['low', 'normal', 'high']) assert.deepEqual(validateOrder({ ...VALID, priority }), []);
+  assert.ok(validateOrder({ ...VALID, priority: 'urgent' }).length > 0);
+  assert.ok(validateOrder({ ...VALID, priority: 1 }).length > 0);
+});
+
+test('order service：create 預設 normal、update 可改 priority、非法 priority 擋下', () => {
+  const svc = createOrderService();
+  const created = svc.create(VALID);
+  assert.equal(created.priority, 'normal');
+  assert.equal(svc.update(created.id, { priority: 'low' }).priority, 'low');
+  assert.equal(svc.update(created.id, {}).priority, 'low');
+  assert.throws(() => svc.create({ ...VALID, priority: 'urgent' }), /priority/);
+  assert.throws(() => svc.update(created.id, { priority: 'urgent' }), /priority/);
+});
+
+test('order service：listByPriority 依優先度篩選', () => {
+  const svc = createOrderService();
+  const low = svc.create({ ...VALID, priority: 'low' });
+  const normal = svc.create(VALID);
+  const high1 = svc.create({ ...VALID, priority: 'high' });
+  const high2 = svc.create({ ...VALID, priority: 'high' });
+  assert.deepEqual(svc.listByPriority('high').map((o) => o.id), [high1.id, high2.id]);
+  assert.deepEqual(svc.listByPriority('normal').map((o) => o.id), [normal.id]);
+  assert.deepEqual(svc.listByPriority('low').map((o) => o.id), [low.id]);
+  assert.throws(() => svc.listByPriority('urgent'), /priority/);
+});
+
+test('order route：GET /orders?priority= 篩選、非法值 400、不帶參數回全部', () => {
